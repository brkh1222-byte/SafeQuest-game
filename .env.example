# Copy to .env.local and fill in. Everything is optional: with nothing set, the
# stage runs on cached scenes only and saves levels to .data/ (offline mode).

# --- Hosted model (OpenAI-compatible: Hugging Face endpoint, Together, ...) ---
SQ_HOSTED_URL=
SQ_HOSTED_API_KEY=
SQ_HOSTED_MODEL_BASE=        # base Gemma 3, for the comparison columns
SQ_HOSTED_MODEL_FT=          # merged SafeQuest LoRA
SQ_HOSTED_TIMEOUT_MS=6000

# --- Local model on the demo laptop (Ollama) ---
SQ_LOCAL_URL=http://localhost:11434/v1
SQ_LOCAL_MODEL_BASE=         # e.g. gemma3:4b
SQ_LOCAL_MODEL_FT=           # e.g. safequest-ft (GGUF imported into Ollama)
SQ_LOCAL_TIMEOUT_MS=9000

# --- Saved levels / Judges' World (set by the Vercel Marketplace Upstash integration) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Stage ---
SQ_STAGE_KEY=                # if set, /stage needs this key to generate or save
NEXT_PUBLIC_SITE_URL=        # public URL used in QR codes (localhost won't open on phones)

# --- Dataset expansion (npm run data -- expand) ---
ANTHROPIC_API_KEY=           # or run `ant auth login` instead
